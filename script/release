#!/usr/bin/env bash

VERSION=${1:-patch}

case "$VERSION" in
  major|minor|patch)
    gh workflow run publish.yml --ref v2 -f bump="$VERSION"
    ;;
  *)
    if [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
      gh workflow run publish.yml --ref v2 -f version="$VERSION"
      exit 0
    fi
    echo "usage: $0 [major|minor|patch|version]" >&2
    exit 1
    ;;
esac
